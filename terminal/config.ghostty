font-size = 13
adjust-cell-height = 50%
font-family = "CommitMonoSkull Nerd Font"

title = "▲"
window-title-font-family = "Geist Mono"

window-theme = light
window-colorspace = display-p3

window-padding-x = 24
window-padding-y = 24

macos-icon = blueprint
macos-titlebar-proxy-icon = hidden

auto-update = download
copy-on-select = false
clipboard-trim-trailing-spaces = true
quick-terminal-position = bottom
shell-integration-features = sudo

cursor-click-to-move = true
cursor-style = bar

palette = 0=#111111
palette = 1=#EC2B2E
palette = 2=#82c507
palette = 3=#f3ab12
palette = 4=#1fbff4
palette = 5=#b76de8
palette = 6=#0abdc7
palette = 7=#999999
palette = 8=#EC2B2E
palette = 9=#82c507
palette = 10=#f3ab12
palette = 11=#1fbff4
palette = 12=#b76de8
palette = 13=#0abdc7
palette = 14=#999999
palette = 15=#ea6cbc
background = ffffff
foreground = 555555
cursor-color = 0abdc7
cursor-text = ffffff
selection-background = 0abdc7
selection-foreground = ffffff

#  General aliases
# =====================

# Update/reload shell configs
alias reload='source ~/.zshrc && echo -e "$fg_bold[yellow]nice~ 👌"'
alias editzsh="open ~/.zshrc"
alias editbash="open ~/.bash_profile"
alias reloadbash='source ~/.bash_profile && echo "Done!"'
alias reloadshell="exec ${SHELL} -l"

# The laziest install ever
alias i="pnpm install"

# Homebrew helper
alias br="brew update"

# Remove .DS_Store, mine enemy!
alias dstore="find . -name '.DS_Store' -type f -delete"

# Edit /etc/hosts file
alias edithosts="open /etc/hosts"

# Navigation helpers
alias ..="cd .."
alias ls="ls -GFh"

# Open Cursor
alias c="open $1 -a \"Cursor\""

# Flush DNS
alias flushdns="dscacheutil -flushcache && killall -HUP mDNSResponder"

# WHOIS lookup
# Use: `whois <domain.com>`
function whois() {
  command whois $(echo $1 | sed -e 's|https?://||' -e 's|/||g')
}

# youtube-dl 
alias rip="yt-dlp"
alias ripVideo="yt-dlp -f 'bestvideo' --recode-video mp4"
alias ripAudio="yt-dlp -f 'bestaudio' --recode-video mp4"
alias subs="yt-dlp --recode-video mp4 --write-sub"
